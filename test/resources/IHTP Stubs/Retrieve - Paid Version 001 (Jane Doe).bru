meta {
  name: Retrieve - Paid Version 001 (Jane Doe)
  type: http
  seq: 13
}

get {
  url: {{ihtp_stubs_url}}/etmp/RESTAdapter/pods/reports/ihtp?pstr=24000001IN&paymentReferenceNumber=A975310/26C-271828&versionNumber=001
  body: none
  auth: none
}

params:query {
  pstr: 24000001IN
  paymentReferenceNumber: A975310/26C-271828
  versionNumber: 001
}

headers {
  correlationid: {{correlationid}}
  X-Message-Type: Request
  X-Originating-System: MDTP
  X-Receipt-Date: 2026-07-25T11:45:00Z
  X-Regime-Type: IHTP
  X-Transmitting-System: MDTP
}

tests {
  test("Returns Jane Doe's paid version 001 report", function () {
      expect(res.getStatus()).to.equal(200);
      expect(res.body.success.ihtpDetails.version).to.equal("001");
      expect(res.body.success.ihtpDetails.status).to.equal("Paid");
      expect(res.body.success.deceasedDetails.inheritanceTaxReference).to.equal("A975310/26C");
      expect(res.body.success.deceasedDetails.firstForename).to.equal("Jane");
      expect(res.body.success.deceasedDetails.secondForename).to.equal("Margaret");
  });
}
