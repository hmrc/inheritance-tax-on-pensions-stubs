meta {
  name: Retrieve - Amendment Version 001
  type: http
  seq: 13
}

get {
  url: {{ihtp_stubs_url}}/etmp/RESTAdapter/pods/reports/ihtp?pstr=24000001IN&paymentReferenceNumber=A556789/26A-758204&versionNumber=001
  body: none
  auth: none
}

params:query {
  pstr: 24000001IN
  paymentReferenceNumber: A556789/26A-758204
  versionNumber: 001
}

headers {
  correlationid: {{correlationid}}
  X-Message-Type: Request
  X-Originating-System: MDTP
  X-Receipt-Date: 2026-07-20T10:00:00Z
  X-Regime-Type: IHTP
  X-Transmitting-System: MDTP
}

tests {
  test("Returns the pinned paid version", function () {
      expect(res.getStatus()).to.equal(200);
      expect(res.body.success.ihtpDetails.version).to.equal("001");
      expect(res.body.success.ihtpDetails.status).to.equal("Paid");
      expect(res.body.success.ihtTaxInformation.changeFlag).to.equal(false);
      expect(res.body.success.beneficiaryDetails.changeFlag).to.equal(false);
  });
}
