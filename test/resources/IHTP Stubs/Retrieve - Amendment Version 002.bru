meta {
  name: Retrieve - Amendment Version 002
  type: http
  seq: 14
}

get {
  url: {{ihtp_stubs_url}}/etmp/RESTAdapter/pods/reports/ihtp?pstr=24000001IN&paymentReferenceNumber=A556789/26A-758204&versionNumber=002
  body: none
  auth: none
}

params:query {
  pstr: 24000001IN
  paymentReferenceNumber: A556789/26A-758204
  versionNumber: 002
}

headers {
  correlationid: {{correlationid}}
  X-Message-Type: Request
  X-Originating-System: MDTP
  X-Receipt-Date: 2026-07-22T14:30:00Z
  X-Regime-Type: IHTP
  X-Transmitting-System: MDTP
}

tests {
  test("Returns the amended version and its change flags", function () {
      expect(res.getStatus()).to.equal(200);
      expect(res.body.success.ihtpDetails.version).to.equal("002");
      expect(res.body.success.ihtpDetails.status).to.equal("Submitted");
      expect(res.body.success.ihtTaxInformation.changeFlag).to.equal(true);
      expect(res.body.success.beneficiaryDetails.changeFlag).to.equal(true);
      expect(res.body.success.beneficiaryDetails.beneficiaries[0].changeFlag).to.equal(true);
      expect(res.body.success.beneficiaryDetails.beneficiaries[1].changeFlag).to.equal(false);
  });
}
