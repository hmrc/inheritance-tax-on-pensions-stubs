meta {
  name: Retrieve - Paid Version 001 (John Doe)
  type: http
  seq: 12
}

get {
  url: {{ihtp_stubs_url}}/etmp/RESTAdapter/pods/reports/ihtp?pstr=24000001IN&paymentReferenceNumber=F246810/26B-314159&versionNumber=001
  body: none
  auth: none
}

params:query {
  pstr: 24000001IN
  paymentReferenceNumber: F246810/26B-314159
  versionNumber: 001
}

headers {
  correlationid: {{correlationid}}
  X-Message-Type: Request
  X-Originating-System: MDTP
  X-Receipt-Date: 2026-07-24T09:15:00Z
  X-Regime-Type: IHTP
  X-Transmitting-System: MDTP
}

tests {
  test("Returns John Doe's paid version 001 report", function () {
      expect(res.getStatus()).to.equal(200);
      expect(res.body.success.ihtpDetails.version).to.equal("001");
      expect(res.body.success.ihtpDetails.status).to.equal("Paid");
      expect(res.body.success.deceasedDetails.inheritanceTaxReference).to.equal("F246810/26B");
      expect(res.body.success.deceasedDetails.firstForename).to.equal("John");
      expect(res.body.success.deceasedDetails.secondForename).to.equal("Edward");
  });
}
